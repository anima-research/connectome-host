#!/usr/bin/env python3
import builtins
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone

C_RED = "\033[31m"
C_YEL = "\033[33m"
C_GRN = "\033[32m"
C_DIM = "\033[2m"
C_OFF = "\033[0m"
if not sys.stdout.isatty():
    C_RED = C_YEL = C_GRN = C_DIM = C_OFF = ""

NOW = time.time()
WARNINGS = []
DUMP_WAIT = 5


def sh(cmd, timeout=15):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip()
    except Exception:
        return ""


def age(ts):
    if ts is None:
        return "never"
    d = NOW - ts
    if d < 0:
        return "future?"
    if d < 90:
        return f"{d:.0f}s ago"
    if d < 5400:
        return f"{d/60:.0f}m ago"
    if d < 172800:
        return f"{d/3600:.1f}h ago"
    return f"{d/86400:.1f}d ago"


def hhmm(ts):
    if ts is None:
        return "--:--:--"
    return datetime.fromtimestamp(ts, tz=timezone.utc).strftime("%m-%d %H:%M:%S")


def parse_iso(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def warn(msg, counts=True):
    WARNINGS.append((msg, counts))


try:
    WITHHOLD = json.loads(os.environ.get("CONNECTOME_DOCTOR_WITHHOLD") or "[]")
    if not isinstance(WITHHOLD, list) or not all(
            isinstance(p, list) and len(p) == 2 and all(isinstance(s, str) for s in p) for p in WITHHOLD):
        raise ValueError("not a list of [name, value] pairs")
except ValueError as e:
    print(f"connectome-doctor: CONNECTOME_DOCTOR_WITHHOLD can't be read ({e}), so what it names can't be "
          "withheld, and nothing is read.")
    sys.exit(2)
WITHHOLD = [(k, v) for k, v in WITHHOLD if v]


def withheld(text):
    found = []
    for name, value in WITHHOLD:
        at = text.find(value)
        while at >= 0:
            found.append((at, at + len(value), name))
            at = text.find(value, at + 1)
    found.sort(key=lambda span: (span[0], -span[1]))
    spans = []
    for start, end, name in found:
        if spans and start < spans[-1][1]:
            spans[-1][1] = max(spans[-1][1], end)
        else:
            spans.append([start, end, name])
    out, at = [], 0
    for start, end, name in spans:
        out += [text[at:start], f"<{name}>"]
        at = end
    out.append(text[at:])
    return "".join(out)


def print(*args, **kwargs):
    builtins.print(*(withheld(str(a)) for a in args), **kwargs)


def run(cmd, timeout=15, no_match=None, cut_is_end=False):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, encoding="utf-8", errors="replace",
                           timeout=timeout)
    except subprocess.TimeoutExpired as e:
        return ("", None) if cut_is_end else (None, str(e))
    except Exception as e:
        return None, str(e)
    if r.returncode == no_match and not r.stderr.strip():
        return "", None
    if r.returncode != 0:
        said = r.stderr.strip().splitlines()
        return None, said[-1] if said else f"exit {r.returncode}"
    return r.stdout, None


def read_text(path, last=None, start=0):
    try:
        with open(path, "rb") as f:
            if last is not None:
                f.seek(0, 2)
                start = max(0, f.tell() - last)
            f.seek(start)
            text = f.read().decode("utf-8", "replace")
    except Exception as e:
        return None, getattr(e, "strerror", None) or str(e)
    if last is not None and start > 0:
        text = text.split("\n", 1)[1] if "\n" in text else ""
    return text, None


args = []
no_signal = False
data_dir = None
findings_json = False
argv = iter(sys.argv[1:])
for a in argv:
    if a == "--no-signal":
        no_signal = True
    elif a == "--data-dir":
        data_dir = next(argv, None)
    elif a == "--findings-json":
        findings_json = True
    else:
        args.append(a)
install_dir = os.path.expanduser(args[0] if len(args) > 0 else "~/mythos-cm")
unit = args[1] if len(args) > 1 else None
if unit is None:
    base = os.path.basename(install_dir.rstrip("/")).replace("-cm", "")
    unit = f"{base}-agent.service"

data_dir = os.path.expanduser(data_dir) if data_dir else os.path.join(install_dir, "data")
logs_dir = os.path.join(install_dir, "logs")

print(f"connectome-doctor — {install_dir}  ({unit})")
print("=" * 72)

props = {}
for line in sh(
    f"systemctl --user show {unit} -p ActiveState -p SubState -p NRestarts "
    f"-p ExecMainStartTimestamp -p MainPID -p StandardOutput -p StandardError"
).splitlines():
    if "=" in line:
        k, v = line.split("=", 1)
        props[k] = v

active = props.get("ActiveState", "?")
pid = props.get("MainPID", "0")
start_ts = None
if props.get("ExecMainStartTimestamp"):
    t = sh(f"date -d '{props['ExecMainStartTimestamp']}' +%s")
    start_ts = float(t) if t else None

col = C_GRN if active == "running" or active == "active" else C_RED
if not findings_json:
    print(f"service    : {col}{active}/{props.get('SubState','?')}{C_OFF}  pid={pid}  "
          f"started {age(start_ts)}  restarts={props.get('NRestarts','?')}")
if active not in ("active", "running") and not findings_json:
    warn(f"service is {active} — start it: systemctl --user start {unit}")
if start_ts and NOW - start_ts < 300 and not findings_json:
    warn(f"service started only {age(start_ts)} — recent restart/crash?")

df = sh("df -h / | tail -1").split()
if len(df) >= 5:
    pct = int(df[4].rstrip("%"))
    col = C_GRN if pct < 80 else (C_YEL if pct < 88 else C_RED)
    print(f"disk /     : {col}{df[4]} used{C_OFF}  ({df[3]} free)")
    if pct >= 88:
        warn(f"disk at {pct}% — agents corrupt stores when writes fail (see 2026-07-02)")

DELIVERY = "routeSpeech delivery"
DELIVERED = r"\[routeSpeech\] .*: routed \d+ chars -> \S"
UNCONFIRMED = r"\[routeSpeech\] .*speech delivery NOT confirmed"
ROUTE_SAID = DELIVERED + r"|\[routeSpeech\] .*speech (NOT routed|delivery NOT confirmed)"
FAILURE = r"\[inference-(failed|hard-down|dropped)\]|\[push-event-rejected\]|Error"


def journal_entries(text):
    entries = []
    for ln in (text or "").split("\n"):
        m = re.match(r"^(\d+(?:\.\d+)?) \S+ [^:]*: (.*)$", ln)
        if m:
            entries.append((float(m.group(1)), m.group(2)))
    return entries


last_entry, last_error = run(f"journalctl --user -u {unit} -q --no-pager -n 1 -o short-unix")
journal_text, search_error = "", None
if last_error is None and start_ts is None:
    search_error = "the unit's start time isn't known"
elif last_error is None:
    journal_text, search_error = run(
        f"journalctl --user -u {unit} -q --no-pager --since @{int(start_ts)} -g {shlex.quote(f'{ROUTE_SAID}|{FAILURE}')} "
        "-o short-unix", no_match=1)
journal_error = last_error if last_error is not None else search_error
journal_unread = ("can't be read" if last_error is not None else "wasn't searched" if start_ts is None
                  else "couldn't be searched by pattern")
journal = journal_entries(journal_text)
jts = (journal_entries(last_entry) or [(None, None)])[-1][0]
log_redirect = None
frag = sh(f"systemctl --user show {unit} -p FragmentPath --value")
if frag and os.path.exists(frag):
    frag_text, frag_why = read_text(frag)
    if frag_text is None:
        warn(f"{unit}'s unit file, {frag}, can't be read ({frag_why}), so whether it sends the host's output to a file "
             "isn't known", counts=False)
    m = re.search(r"Standard(?:Output|Error)=(?:append|file):(\S+)", frag_text or "")
    if m:
        log_redirect = m.group(1)

agent_log = log_redirect or os.path.join(logs_dir, "agent.log")
if log_redirect:
    journal_log = False
elif os.path.exists(agent_log):
    journal_log = start_ts is not None and os.path.getmtime(agent_log) < start_ts
else:
    journal_log = True
if last_error is not None:
    print(f"journal    : {C_RED}can't be read: {last_error}{C_OFF}")
else:
    print(f"journal    : last entry {age(jts)}" + ("" if journal_log else f"  {C_DIM}(stdout/err -> {agent_log}){C_OFF}")
          + (f"  {C_RED}its search by pattern failed: {search_error}{C_OFF}"
             if journal_log and search_error is not None and start_ts is not None else ""))
    if not journal_log and (jts is None or (start_ts and jts < start_ts)):
        warn(f"journalctl is STALE for this unit (unit logs to a file) — real logs: {agent_log}", counts=False)
if journal_log and journal_error is not None:
    warn(f"{unit}'s journal {journal_unread} ({journal_error}), so its failures"
         + (", deliveries and gate dump" if last_error is not None else " and deliveries") + " aren't shown",
         counts=False)

stages = []

dbg = os.path.join(data_dir, "discord-mcpl-debug.log")
enter_ts = fwd_ts = None
enter_detail = fwd_detail = ""
dbg_text, dbg_why = read_text(dbg, last=2_000_000) if os.path.exists(dbg) else (None, None)
discord_unknown = dbg_text is None


def dbg_fields(ln):
    try:
        fields = json.loads(ln.split(" ", 2)[2])
    except Exception:
        return {}
    return fields if isinstance(fields, dict) else {}


if discord_unknown:
    enter_detail = (f"discord-mcpl's debug log at {dbg} can't be read ({dbg_why})" if dbg_why is not None else
                    f"discord-mcpl's debug log isn't at {dbg}, and it writes one only when DISCORD_MCPL_DEBUG_LOG "
                    "names it")
    fwd_detail = "it's read from the same debug log"
else:
    dbg_lines = dbg_text.splitlines()

    def last_in_dbg(pattern):
        matches = [ln for ln in dbg_lines if re.search(pattern, ln)]
        return matches[-1] if matches else None

    ln = last_in_dbg(r"handleDiscordMessage:enter")
    if ln:
        enter_ts = parse_iso(ln.split(" ", 1)[0])
        mm = re.search(r'"channelName":"?([^",]*)"?.*?"contentPreview":"(.{0,40})', withheld(ln))
        if mm:
            enter_detail = f"#{mm.group(1)}: {mm.group(2)}…"
    ln = last_in_dbg(r'gateway:message-create-drop (?!.*"reason":"self-authored")')
    if ln:
        dts = parse_iso(ln.split(" ", 1)[0])
        reason = dbg_fields(ln).get("reason")
        if dts and NOW - dts < 3600 and isinstance(reason, str):
            enter_detail = f"{enter_detail}  last filter drop {age(dts)}: {reason}".strip()
    ln = last_in_dbg(r"handleDiscordMessage:(sent|forwarding)")
    if ln:
        fwd_ts = parse_iso(ln.split(" ", 1)[0])
        fwd_detail = "push/event" if "push/event" in ln else "channels/incoming"
    ln = last_in_dbg(r"handleDiscordMessage:drop")
    stages_note = None
    if ln:
        dts = parse_iso(ln.split(" ", 1)[0])
        mm = re.search(r'"reason":"([^"]*)"', withheld(ln))
        if dts and NOW - dts < 3600 and mm:
            stages_note = f"last drop {age(dts)}: {mm.group(1)}"
    if stages_note:
        fwd_detail = f"{fwd_detail}  {stages_note}".strip()
DISCORD_SEEN, DISCORD_FORWARD = "discord event seen", "mcpl forward to host"
stages.append((DISCORD_SEEN, enter_ts, enter_detail))
stages.append((DISCORD_FORWARD, fwd_ts, fwd_detail))

rec_ts = None
rec_detail = ""
records = None
ingest_unknown = False
sessions_dir = os.path.join(data_dir, "sessions")
session_index = os.path.join(data_dir, "sessions.json")

if os.path.lexists(session_index):
    try:
        with open(session_index, encoding="utf-8") as f:
            index = json.load(f)
        if not isinstance(index, dict):
            raise ValueError("it isn't a JSON object")
    except Exception as e:
        ingest_unknown = True
        why = getattr(e, "strerror", None) or str(e)
        rec_detail = f"sessions.json can't be read as the host's session index ({why}), so which session is active isn't known"
    else:
        active_session = index.get("activeSessionId")
        if not isinstance(active_session, str) or not active_session:
            ingest_unknown = True
            rec_detail = ("sessions.json names no active session, which no start of the host leaves, so which session "
                          "is active isn't known")
        else:
            path = os.path.join(sessions_dir, active_session, "records.log")
            try:
                os.stat(path)
            except (FileNotFoundError, NotADirectoryError):
                store = os.path.join(sessions_dir, active_session)
                if os.path.lexists(store):
                    ingest_unknown = True
                    rec_detail = (f"the active session's store, {store}, is there without a records.log, which the host "
                                  "writes when it opens the store, so what was ingested isn't known")
                else:
                    rec_detail = f"the active session, {active_session}, has no records.log"
            except OSError as e:
                ingest_unknown = True
                rec_detail = f"{path} can't be read ({e.strerror or str(e)})"
            else:
                records = path
else:
    try:
        held = os.listdir(sessions_dir)
    except FileNotFoundError:
        held = []
    except OSError as e:
        held = []
        ingest_unknown = True
        rec_detail = f"{sessions_dir} can't be listed ({e.strerror or str(e)})"
    if held:
        ingest_unknown = True
        rec_detail = "no sessions.json names the active session"
if records:
    data, why = read_text(records, last=8_000_000)
    if why is not None:
        ingest_unknown = True
        rec_detail = f"{records} can't be read ({why})"
    data = data or ""
    last_msg = None
    for mm in re.finditer(r'\{"record_id":\d+,"global_sequence":\d+,"state_id":"messages".*?"timestamp":(\d+)\}', data):
        last_msg = mm
    try:
        size = os.path.getsize(records)
    except OSError:
        size = 0
    if last_msg is None and why is None and size > 0:
        ingest_unknown = True
        rec_detail = (f"the last 8 MB of {records} hold no message record in the JSON-lines form this "
                      "ladder reads")
    if last_msg:
        rec_ts = int(last_msg.group(1)) / 1_000_000  # store stamps in microseconds
        arr = re.search(r"\[([0-9,]{40,})\]", last_msg.group(0))
        if arr:
            try:
                payload = bytes(int(x) for x in arr.group(1).split(",")).decode("utf-8", "replace")
                trig = '"triggered":true' in payload
                pm = re.search(r'"participant":"([^"]*)"', withheld(payload))
                cm = re.search(r'"channelName":"([^"]*)"', withheld(payload))
                rec_detail = (f"{'triggered=true' if trig else 'triggered=false (gate skip)'}"
                              + (f"  #{cm.group(1)}" if cm else "")
                              + (f"  by {pm.group(1)}" if pm else ""))
                if trig:
                    rec_detail = rec_detail
                globals()["_last_ingest_triggered"] = trig
            except Exception:
                pass
INGEST = "chronicle ingest (+gate)"
stages.append((INGEST, rec_ts, rec_detail))

def err_text(err):
    if isinstance(err, dict):
        return str(err.get("message") or err.get("name") or "")
    return "" if err is None else str(err)


llm_ts = None
llm_detail = ""
turn_ts = None
turn_ok = False
llm_window_from = None
llm_written_at = None
llm_unsure = False
newer_unread = False
llm_unread = None
LLM_WINDOW = 30_000_000
if not os.path.isdir(data_dir):
    warn(f"there's no data directory at {data_dir}, so the discord, mcpl, chronicle and inference stages read nothing"
         + ("" if findings_json else "; if the host keeps it elsewhere, run this script with --data-dir DIR"),
         counts=False)
try:
    llm_files = sorted(
        (f for f in (os.listdir(data_dir) if os.path.isdir(data_dir) else []) if f.startswith("llm-calls.")),
        key=lambda f: os.path.getmtime(os.path.join(data_dir, f)),
    )
    if llm_files:
        newest = os.path.join(data_dir, llm_files[-1])
        size = os.path.getsize(newest)
        llm_written_at = os.path.getmtime(newest)
except OSError as e:
    llm_files, llm_written_at = [], None
    llm_unread = e.strerror or str(e)
    llm_detail = f"{e.filename or data_dir} can't be read ({llm_unread})"
if llm_files:
    where = "the newest file's last 30 MB" if size > LLM_WINDOW + 1 else "the newest file"
    # Split at newlines only: splitlines() also splits at U+2028, U+2029 and
    # U+0085, which JSON.stringify leaves unescaped inside a row.
    llm_text, llm_unread = read_text(newest, last=LLM_WINDOW + 1)
    lines = (llm_text or "").split("\n")
    last = lines.pop() if lines else ""
    incomplete = False
    if last.strip():
        try:
            json.loads(last)
            lines.append(last)
        except Exception:
            incomplete = True
    call = None
    pokes = 0
    unreadable = 0
    before_ingest = rec_ts is not None and llm_written_at < rec_ts - 120
    llm_unsure = incomplete and not before_ingest
    for ln in reversed(lines):
        ln = ln.strip()
        if not ln.startswith("{"):
            continue
        try:
            r = json.loads(ln)
        except Exception:
            unreadable += 1
            llm_unsure = llm_unsure or not before_ingest
            continue
        r_ts = parse_iso(str(r.get("timestamp", "")))
        if rec_ts is not None and r_ts is not None and r_ts < rec_ts - 120:
            before_ingest = True
        llm_window_from = r_ts or llm_window_from
        if r.get("kind") == "keepalive":
            pokes += 1
            continue
        if call is None:
            call = r
        if r.get("kind") == "stream":
            turn_ts = parse_iso(str(r.get("timestamp", "")))
            turn_resp = r.get("rawResponse") or {}
            turn_resp = turn_resp.get("response") or turn_resp
            turn_ok = not (r.get("type") == "error" or turn_resp.get("error") or r.get("error"))
            # Not llm_unsure, which leaves out rows from before the last ingest: whether a call after this
            # turn failed rests on every row after it.
            newer_unread = incomplete or unreadable > 0
            llm_window_from = None
            break
    if call is not None:
        llm_ts = parse_iso(str(call.get("timestamp", "")))
        resp = call.get("rawResponse") or {}
        resp = resp.get("response") or resp
        sr = resp.get("stop_reason")
        err = resp.get("error") or call.get("error")
        stop = "" if sr is None else f"stop={sr}  "
        if call.get("type") == "error" or err:
            llm_detail = f"{stop}{C_RED}err={withheld(err_text(err))[:80] or '(no text)'}{C_OFF}"
        else:
            llm_detail = stop.strip() or "answered"
        if sr == "refusal":
            warn("last model response was a REFUSAL — check context contamination "
                 "(see project_mythos: contextBudgetTokens fix)")
    elif llm_unread is not None:
        llm_detail = f"the newest call log, {llm_files[-1]}, can't be read ({llm_unread})"
    else:
        llm_detail = f"no readable model call in {where}" + (
            f": {pokes} keepalive poke(s)" if pokes else "")
    if unreadable:
        llm_detail += f"  {C_YEL}{unreadable} row(s){' since the last turn' if turn_ts else ''} unreadable{C_OFF}"
    if incomplete:
        llm_detail += f"  {C_YEL}last row incomplete (being written, or cut off){C_OFF}"
elif llm_unread is None and os.path.isdir(data_dir):
    llm_detail = f"no call log in {data_dir}"
INFERENCE = "inference (llm call)"
stages.append((INFERENCE, llm_ts, llm_detail))

unknown = {INGEST} if ingest_unknown else set()
if llm_unread is not None:
    unknown.add(INFERENCE)
if discord_unknown:
    unknown |= {DISCORD_SEEN, DISCORD_FORWARD}
if not os.path.isdir(data_dir):
    unknown |= {INGEST, INFERENCE}
    stages = [(name, ts, f"there's no data directory at {data_dir}" if name in (INGEST, INFERENCE) else detail)
              for name, ts, detail in stages]
unsure = set()
failed = set()
del_ts = None
del_detail = ""
last = None
if journal_log:
    said = [(ts, msg) for ts, msg in journal if re.search(ROUTE_SAID, msg)]
    delivered = [(ts, msg) for ts, msg in said if re.search(DELIVERED, msg)]
    if delivered:
        del_ts = delivered[-1][0]
    if said:
        last = said[-1][1]
        if not delivered:
            unknown.add(DELIVERY)
    else:
        unknown.add(DELIVERY)
        del_detail = ("the unit has no start time, so no run's journal is read" if last_error is None and start_ts is None
                      else f"the journal {journal_unread}" if journal_error is not None
                      else "none in the journal since the unit's latest start")
else:
    text, why = read_text(agent_log, last=2_000_000)
    said = [ln for ln in (text or "").split("\n") if re.search(ROUTE_SAID, ln)]
    if why is not None:
        unknown.add(DELIVERY)
        del_detail = f"{agent_log} can't be read"
    elif not said:
        unknown.add(DELIVERY)
        del_detail = "none in its last 2 MB"
    else:
        last = said[-1]
        if re.search(DELIVERED, last):
            del_ts = os.path.getmtime(agent_log)  # agent.log lines lack timestamps
        else:
            unknown.add(DELIVERY)
if last is not None and re.search(DELIVERED, last):
    mm = re.search(r"routed (\d+) chars -> (\S+)", last)
    del_detail = f"routed {mm.group(1)}ch -> {mm.group(2)}"
elif last is not None:
    line = last.split('[routeSpeech] ', 1)[-1]
    if "no locus" in last:
        failed.add(DELIVERY)
        del_detail = f"{C_RED}NO LOCUS — speech stayed in chronicle{C_OFF}"
        warn(f"the last reply had no locus, so it wasn't delivered and stays in the chronicle: {line}")
    elif re.search(UNCONFIRMED, last):
        unsure.add(DELIVERY)
        del_detail = f"{C_YEL}delivery NOT confirmed{C_OFF}"
        warn(f"the last reply's delivery wasn't confirmed, so it may or may not be in its channel: {line}", counts=False)
    else:
        failed.add(DELIVERY)
        del_detail = f"{C_RED}NOT delivered{C_OFF}"
        warn(f"the last reply wasn't delivered: {line}")
stages.append((DELIVERY, del_ts, del_detail))


def file_failures(path, is_failure):
    text, why = read_text(path, last=400_000)
    if text is None:
        return path, None, f"it can't be read ({why})", f"{path} can't be read ({why}), so its failures aren't shown"
    return path, [ln for ln in text.split("\n") if ln.strip() and is_failure(ln)], None, None


def record_of(ln, kind):
    try:
        record = json.loads(ln)
    except ValueError:
        return None
    return record if isinstance(record, dict) and record.get("kind") == kind else None


def exhausted(ln):
    return record_of(ln, "inference-exhausted")


sources = []
if journal_log:
    sources.append((f"{unit}'s journal", None if journal_error is not None
                    else [msg for _, msg in journal if re.search(FAILURE, msg)],
                    f"it {journal_unread} ({journal_error})", None))
else:
    sources.append(file_failures(agent_log, lambda ln: re.search(FAILURE, ln)))
failures_log = os.path.join(logs_dir, "failures.log")
try:
    os.lstat(failures_log)
    failures_there = True
except (FileNotFoundError, NotADirectoryError):
    failures_there = False
except OSError:
    failures_there = True
if failures_there:
    sources.append(file_failures(failures_log, lambda ln: record_of(ln, "subscription-gc-close") is None))
times = [ts for ts, msg in journal if "inference-failed" in msg] if journal_log else []
untimed = False
for index, (_, found, _, _) in enumerate(sources):
    for ln in found or []:
        record = exhausted(ln)
        if record is not None:
            ts = parse_iso(record["at"]) if isinstance(record.get("at"), str) else None
            if ts is None:
                untimed = True
            else:
                times.append(ts)
        elif "inference-failed" in ln and not (journal_log and index == 0):
            untimed = True
unseen_why = "the call log can't be read here"
if (times or untimed) and not llm_files and llm_unread is None and os.path.isdir(data_dir):
    unknown.add(INFERENCE)
    unseen_why = f"there's no call log in {data_dir}"

print()
print("pipeline ladder (last seen per stage):")
prev_ts = None
for name, ts, detail in stages:
    mark = f"{C_GRN}o{C_OFF}" if ts else f"{C_RED}x{C_OFF}"
    lag = ""
    if prev_ts and ts and prev_ts - ts > 300:
        lag = f"  {C_YEL}<-- lags upstream by {age(ts).replace(' ago','')} vs {age(prev_ts).replace(' ago','')}{C_OFF}"
        mark = f"{C_YEL}!{C_OFF}"
    if name in unknown or name in unsure:
        mark = f"{C_YEL}?{C_OFF}"
    if name in failed:
        mark = f"{C_RED}x{C_OFF}"
    if name in unknown and name not in failed and name not in unsure:
        print(f"  · {name:<26} can't be seen here" + (f": {C_DIM}{detail}{C_OFF}" if detail else ""))
        continue
    seen = "not known" if name in unknown else age(ts)
    print(f"  {mark} {name:<26} {hhmm(ts)}  ({seen:>9})  {C_DIM}{detail}{C_OFF}{lag}")
    if ts:
        prev_ts = ts

NO_TURN = "NO turn was recorded after it"
no_turn_after = turn_ts is None or (rec_ts is not None and turn_ts < rec_ts - 120)
window_from = llm_window_from if llm_window_from is not None else llm_written_at
turn_unknown = (bool(llm_files) or llm_unread is not None) and (llm_unsure or (turn_ts is None and (
    window_from is None or (rec_ts is not None and rec_ts < window_from))))
if globals().get("_last_ingest_triggered") and rec_ts and no_turn_after and not turn_unknown:
    warn(f"a gate-TRIGGERED event was ingested but {NO_TURN} — events may be "
         "dying between the gate and the model (check inference policy drops / "
         "budget failures / [diagnostics] dump below)")

print()
for where, found, why, unread in sources:
    if unread is not None:
        warn(unread, counts=False)
    if found is None:
        print(f"recent failures in {where}: {C_YEL}not known: {why}{C_OFF}")
    elif found:
        print(f"recent failures in {where}:")
        for ln in found[-5:]:
            print(f"  {C_RED}{withheld(ln)[:150]}{C_OFF}")
    else:
        print(f"recent failures in {where}: {C_GRN}none found{C_OFF}")
if times or untimed:
    failed_at = max(times) if times else None
    timed = " whose time is known" if untimed else ""
    if failed_at is not None and turn_ok and turn_ts is not None and turn_ts > failed_at:
        warn(f"last inference failure{timed} {age(failed_at)}: a later call, at {hhmm(turn_ts)}, succeeded; the call log "
             "doesn't say whose, so whether the agent that failed has recovered isn't known" + (
                 "; newer rows of the call log can't be read, so whether a call after it failed isn't known"
                 if newer_unread else ""), counts=False)
    elif failed_at is not None and INFERENCE in unknown:
        warn(f"inference failures, the last{timed} {age(failed_at)}; whether a turn has succeeded since isn't known, "
             f"since {unseen_why}", counts=False)
    elif failed_at is not None:
        warn(f"inference failures, the last{timed} {age(failed_at)}, with no successful turn found since — if the reason "
             "repeats identically, the agent is hard-down until config changes (e.g. budget)")
    else:
        warn("inference failures present, and when the last was isn't known here, so neither is whether a turn has "
             "succeeded since — if the reason repeats identically, the agent is hard-down until config changes (e.g. budget)",
             counts=False)


def usr2_listener(pid):
    try:
        with open(f"/proc/{pid}/status") as f:
            for ln in f:
                if ln.startswith("SigCgt:"):
                    # A hex mask of the signals the process catches, signal n at bit n - 1 (proc(5)).
                    return (int(ln.split()[1], 16) >> (signal.SIGUSR2 - 1)) & 1 == 1
    except Exception:
        return None
    return None


if no_signal:
    print()
    print(f"live gate dump: {C_DIM}left out (--no-signal), so the host got no SIGUSR2{C_OFF}")
elif pid not in ("0", "", None) and active in ("active", "running"):
    pid = sh(f"systemctl --user show {unit} -p MainPID --value") or "0"
    listening = usr2_listener(pid) if pid != "0" else None
    print()
    if pid == "0":
        print(f"live gate dump: {C_DIM}not asked: the unit has no main process now{C_OFF}")
    elif listening is None:
        print(f"live gate dump: {C_DIM}not asked: /proc/{pid}/status can't be read, so whether SIGUSR2 would end "
              f"the host isn't known{C_OFF}")
        warn(f"the gate dump wasn't asked for, since /proc/{pid}/status can't be read, so the gate dump isn't known",
             counts=False)
    elif not listening:
        print(f"live gate dump: {C_DIM}not asked: the host (pid {pid}) has no SIGUSR2 listener, and the signal "
              f"would end it. A host still starting installs one once its framework is built, so run this check "
              f"again in a minute; one whose agent-framework predates the dump never does{C_OFF}")
        warn(f"the gate dump wasn't asked for, since the host (pid {pid}) has no SIGUSR2 listener, so the gate dump "
             "isn't known", counts=False)
    else:
        before = os.path.getsize(agent_log) if os.path.exists(agent_log) else 0
        signalled = int(time.time())
        _, refused = run(f"kill -USR2 {pid}")
        dump = why = None
        if refused is None:
            deadline = time.monotonic() + DUMP_WAIT
            while dump is None and why is None:
                left = deadline - time.monotonic()
                if left <= 0:
                    break
                if journal_log:
                    said, why = run(f"journalctl --user -u {unit} -o cat --no-pager --since @{signalled}", timeout=left,
                                    cut_is_end=True)
                    where = f"{unit}'s journal"
                else:
                    said, why = read_text(agent_log, start=before)
                    where = agent_log
                # Split at newlines only: the dump is JSON, which can hold U+2028.
                for ln in (said or "").split("\n"):
                    if "[diagnostics]" in ln:
                        dump = ln
                if dump is None and why is None:
                    time.sleep(min(0.1, max(0.0, deadline - time.monotonic())))
        if refused is not None:
            print(f"live gate dump: {C_RED}SIGUSR2 couldn't be sent ({refused}){C_OFF}")
            warn(f"SIGUSR2 couldn't be sent ({refused}), so the gate dump isn't known", counts=False)
        elif why is not None:
            print(f"live gate dump: {C_RED}SIGUSR2 sent, but {where} can't be read ({why}), so whether a "
                  f"[diagnostics] line came isn't known{C_OFF}")
            warn(f"SIGUSR2 was sent, but {where} can't be read ({why}), so the gate dump isn't known", counts=False)
        elif dump:
            print(f"live gate dump (SIGUSR2): {dump.split('[diagnostics] ',1)[-1]}")
            try:
                d = json.loads(dump.split("[diagnostics] ", 1)[-1])
                g = d.get("gate") or {}
                if g.get("inferring") and g.get("bufferedEvents", 0) > 0:
                    warn("WAKE-WEDGE signature: agent stuck in `inferring` with events buffering")
                if g.get("sleepUntil", 0) > NOW * 1000:
                    warn(f"agent is ASLEEP until {hhmm(g['sleepUntil']/1000)}", counts=False)
                if d.get("activeStreams"):
                    WARNINGS[:] = [w for w in WARNINGS if NO_TURN not in w[0]]
                    print(f"  {C_GRN}turn in-flight for: {', '.join(d['activeStreams'])}{C_OFF}")
            except Exception:
                pass
        else:
            print(f"live gate dump: {C_DIM}no [diagnostics] line was seen within {DUMP_WAIT} s of SIGUSR2, which the host "
                  f"catches and answers by writing that line{C_OFF}")
            warn(f"no [diagnostics] line was seen within {DUMP_WAIT} s of SIGUSR2, so the gate dump isn't known",
                 counts=False)

if findings_json:
    builtins.print("connectome-doctor findings: " + json.dumps([{"text": withheld(w), "counts": counts}
                                                             for w, counts in WARNINGS]))
    sys.exit(0)
print()
if WARNINGS:
    print(f"{C_YEL}=== findings ==={C_OFF}")
    for w, _ in WARNINGS:
        print(f"  {C_YEL}*{C_OFF} {w}")
    sys.exit(1)
else:
    blind = [name for name, _, _ in stages if name in unknown]
    if blind:
        print(f"{C_GRN}=== no obvious problems in what it could see; not known: {', '.join(blind)} ==={C_OFF}")
    else:
        print(f"{C_GRN}=== no obvious problems — pipeline looks alive ==={C_OFF}")

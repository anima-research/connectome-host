{
  "name": "WebUI Fleet Test",
  "description": "WebUI tree-rendering smoke test: parent at http://127.0.0.1:8788, child WebUI at http://127.0.0.1:8787",
  "agent": {
    "name": "conductor",
    "systemPrompt": "You are a test conductor."
  },
  "modules": {
    "subagents": false,
    "lessons": false,
    "retrieval": false,
    "wake": false,
    "workspace": false,
    "webui": { "host": "127.0.0.1", "port": 8788 },
    "fleet": {
      "children": [
        {
          "name": "minion",
          "recipe": "webui-test.json",
          "dataDir": "./tmp-webui-fleet-test/minion",
          "autoStart": true,
          "subscription": ["lifecycle", "inference:completed"]
        }
      ]
    }
  }
}
